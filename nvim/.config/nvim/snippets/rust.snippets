  pub enum ${1}Msg {
  }

  impl Component for ${1} {
    type Message = ${1}Msg;
    type Properties = ();

    fn create(ctx: &Context<Self>) -> Self {
      Self
    }

    fn view(&self, ctx: &Context<Self>) -> Html {
      html! {
        $0
      }
    }
  }
